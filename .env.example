# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/shopnest_db

# ─── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── Admin Seeding ────────────────────────────────────────────────────────────
# Protects the POST /api/admin/seed endpoint
# Remove or leave empty to disable the endpoint entirely
SEED_SECRET=your-seed-secret-key
